[sub_resource type="Shader" id="warp_shader"]
code = "shader_type canvas_item; uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap; uniform float warp_amount : hint_range(0.0, 0.08) = 0.0; void fragment() { vec2 uv = SCREEN_UV; vec2 d = uv - vec2(0.5); float dist = length(d); vec2 off = d * warp_amount * (0.5 + 0.5 * (1.0 - dist)); uv += off; COLOR = texture(SCREEN_TEXTURE, uv); }"

